{
  "name": "FortressEye",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "lint": "next lint",
    "prepare": "husky install",
    "lint-staged": "lint-staged --config .lintstagedrc.js",
    "format": "dprint fmt",
    "next:postinstall": "husky install electron-builder install-app-deps",
    "electron:dist": "electron-builder --dir",
    "electron:dist:deb": "electron-builder --linux deb",
    "electron:build": "tsup",
    "build": "run-s next:build electron:build",
    "dist": "run-s next:build electron:dist",
    "dev": "npm-run-all --parallel electron:dev next:dev",
    "electron:build_watch": "tsup --watch",
    "electron:dev": "npm-run-all --parallel electron:build_watch electron:watch",
    "electron:watch": "cross-env NODE_ENV='development' nodemon"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fontsource/poppins": "^5.1.1",
    "@fontsource/source-sans-pro": "^5.0.8",
    "@hookform/resolvers": "^3.3.2",
    "@mdi/js": "^7.3.67",
    "@mdi/react": "^1.6.1",
    "@mui/material": "^5.14.19",
    "@reduxjs/toolkit": "^1.9.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@urql/devtools": "^2.0.3",
    "axios": "^1.6.7",
    "crypto-js": "^4.2.0",
    "framer-motion": "^10.16.12",
    "get-port-please": "^3.1.2",
    "graphql": "^16.8.1",
    "graphql-ws": "^5.14.2",
    "greeting-time": "^1.0.0",
    "husky": "^8.0.3",
    "isomorphic-ws": "^5.0.0",
    "jwt-decode": "^4.0.0",
    "mapbox-gl": "^3.9.4",
    "moment": "^2.29.4",
    "motion": "^12.4.1",
    "next": "14.0.3",
    "next-urql": "^5.0.2",
    "react": "^18",
    "react-dom": "^18",
    "react-easy-crop": "^5.2.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^4.12.0",
    "react-image-crop": "^11.0.7",
    "react-map-gl": "^8.0.1",
    "react-moment": "^1.1.3",
    "react-redux": "^8.1.3",
    "redux-logger": "^3.0.6",
    "redux-persist": "^6.0.0",
    "sass": "^1.69.5",
    "sharp": "^0.33.0",
    "socket.io-client": "^4.8.1",
    "urql": "^4.0.6",
    "ws": "^8.15.1",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@swc/core": "^1.10.16",
    "@types/crypto-js": "^4.2.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-map-gl": "^6.1.7",
    "@types/redux-logger": "^3.0.12",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8",
    "eslint-config-next": "14.0.3",
    "lint-staged": "^15.1.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "tsup": "^8.3.6",
    "typescript": "^5"
  },
  "build": {
    "asar": true,
    "executableName": "NextJSElectron",
    "appId": "com.saybackend.nextjs-electron",
    "asarUnpack": [
      "node_modules/next",
      "node_modules/@img",
      "node_modules/sharp",
      "**\\*.{node,dll}"
    ],
    "files": [
      "dist/**/*",
      "build",
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "!**/.env",
          "!**/package.json"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/static"
      },
      {
        "from": "public",
        "to": "app/public"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development"
    }
  },
  "main": "dist/main.js",
  "license": "MIT"
}
